# ========================
# Zai-2API 环境变量配置
# ========================
# 复制此文件为 .env 并填入实际值

# ========================
# Hugging Face 配置
# ========================
HF_TOKEN=your_hf_token_here

# ========================
# API 安全配置
# ========================
API_MASTER_KEY=your_secret_key_here

# ========================
# 服务端口配置
# ========================
PORT=8000

# ========================
# WebDAV 数据持久化配置
# ========================
# 用于存储登录状态、Cookie等数据
WEBDAV_URL=https://rebun.infini-cloud.net/dav
WEBDAV_USER=your_webdav_user
WEBDAV_PASS=your_webdav_password

# ========================
# 路径配置
# ========================
DB_PATH=data/zai.db
USER_DATA_DIR=zai_user_data

# ========================
# 自动刷新配置
# ========================
REFRESH_INTERVAL=3600
PREVIEW_MODE=false

# ========================
# 日志级别
# ========================
LOG_LEVEL=INFO
